# Get token from Telegram @BotFather
BOT_TOKEN=
# Telegram numerical IDs (not usernames). Multiple: 123,456
ADMIN_IDS=
# Use Postgres in production; local-only SQLite shown below
DATABASE_URL=sqlite+aiosqlite:///./bot.db
# Grizzly SMS key from grizzlysms.com Settings. Keep it private.
PROVIDER_NAME=grizzly
# Use an account API key, not a Telegram bot token.
PROVIDER_API_KEY=
# Confirm Grizzly's raw API price currency/unit before enabling paid operations.
# IMPORTANT: Set LIVE_PURCHASES_ENABLED=true only AFTER verifying Grizzly pricing,
# wallet conversion, refund handling and completing controlled tests.
LIVE_PURCHASES_ENABLED=false
# Currency code displayed to users. Match provider units! For crypto fiat topups, see README.
WALLET_CURRENCY=USD
# Manual factor converting Grizzly raw quoted amount into the selected wallet fiat currency.
# Set 0 to disable real buying until you have confirmed the exchange rate from 5sim.
PROVIDER_PRICE_TO_WALLET=0
# Payment gateway: cryptobot or nowpayments
PAYMENT_PROVIDER=nowpayments
# NOWPayments merchant API key and IPN secret from account.nowpayments.io
# Never put secrets here; enter them in Render Environment.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Public https URL of this Render web service (no trailing slash)
PUBLIC_BASE_URL=https://telegram-sms-bot-tgcg.onrender.com
# Leave false until both credentials, payout wallet and tests are verified.
PAYMENT_API_KEY=
PAYMENTS_ENABLED=false
PAYMENT_BASE_URL=https://pay.crypt.bot/api
# Optional: webhook in CryptoBot app settings points to /webhook/cryptobot.
# Crypto Pay validates webhook with HMAC derived from PAYMENT_API_KEY.
MARKUP_PERCENT=50
MIN_TOPUP=2
MAX_TOPUP=500
ACTIVATION_TIMEOUT_SECONDS=900
PROVIDER_LOW_BALANCE_ALERT=10
# Optional comma-separated list of service or country slugs to allow; empty allows all, except blocked categories.
ALLOWED_SERVICES=telegram,whatsapp,google,facebook,instagram,discord,amazon,microsoft
ALLOWED_COUNTRIES=
BLOCKED_SERVICES=bank,government,cryptoexchange
